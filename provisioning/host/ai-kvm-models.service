[Unit]
Description=ai-kvm host forwards: local vLLM (qwen27 :8000, Holo4 :8010) to the KVM on the dev AP; the KVM's MCP server (:8090) to Tailscale peers
After=network.target

[Service]
ExecStart=/bin/sh -c 'socat TCP-LISTEN:8000,bind=100.93.148.36,fork,reuseaddr TCP:127.0.0.1:8000 & socat TCP-LISTEN:8010,bind=100.93.148.36,fork,reuseaddr TCP:127.0.0.1:8010 & exec socat TCP-LISTEN:8090,bind=100.93.148.36,fork,reuseaddr TCP:100.98.36.92:8090'
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
