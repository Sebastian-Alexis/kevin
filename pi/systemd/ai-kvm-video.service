[Unit]
Description=ai-kvm HDMI capture (tc358743 + ustreamer)
# Start as early as possible: setting the EDID raises hotplug, which is when the target sees the display.
# capture-init.sh waits for /dev/video0 itself.
After=systemd-modules-load.service

[Service]
ExecStartPre=/opt/ai-kvm/video/capture-init.sh /dev/video0
ExecStart=/usr/bin/ustreamer --device=/dev/video0 --format=uyvy --dv-timings --persistent \
  --encoder=M2M-IMAGE --quality=80 --desired-fps=15 --workers=1 --drop-same-frames=15 \
  --host=127.0.0.1 --port=8081 --allow-origin=*
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
