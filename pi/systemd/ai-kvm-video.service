[Unit]
Description=ai-kvm HDMI capture (tc358743 + ustreamer)
# Early boot: setting the EDID raises hotplug, and the target then needs a few seconds to (re)configure the
# display. Starting before basic.target lets that overlap with Wi-Fi association instead of following it.
# capture-init.sh waits for /dev/video0 itself.
DefaultDependencies=no
# only reads /opt (root filesystem) and writes /run (mounted first thing): no need to wait for local-fs/swap
After=systemd-modules-load.service
Conflicts=shutdown.target
Before=shutdown.target

[Service]
ExecStartPre=/opt/ai-kvm/video/capture-init.sh /dev/video0
ExecStart=/usr/bin/ustreamer --device=/dev/video0 --format=uyvy --dv-timings --persistent \
  --encoder=M2M-IMAGE --quality=80 --desired-fps=15 --workers=1 --drop-same-frames=15 \
  --host=127.0.0.1 --port=8081 --allow-origin=*
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
