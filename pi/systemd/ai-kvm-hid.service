[Unit]
Description=ai-kvm USB HID gadget (keyboard + absolute mouse)
# Early boot: the target enumerates the keyboard/mouse as soon as the UDC is bound.
DefaultDependencies=no
After=sys-kernel-config.mount systemd-modules-load.service
Requires=sys-kernel-config.mount
Before=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/ai-kvm/hid/gadget-up.sh
ExecStop=/opt/ai-kvm/hid/gadget-down.sh

[Install]
WantedBy=sysinit.target
