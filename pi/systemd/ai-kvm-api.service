[Unit]
Description=ai-kvm control API
# Binds 0.0.0.0, so it needs no network-online wait: it is ready the moment Wi-Fi associates.
After=ai-kvm-hid.service
Wants=ai-kvm-hid.service

[Service]
ExecStart=/usr/bin/python3 /opt/ai-kvm/api/server.py
Environment=AIKVM_PORT=8080 AIKVM_STREAM=http://127.0.0.1:8081
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
